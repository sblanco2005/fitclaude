generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Fitness profile fields
  age                Int?
  weightKg           Float?
  heightCm           Float?
  fitnessGoal        String?   // build_muscle, lose_fat, maintain, endurance, flexibility
  experienceLevel    String?   // beginner, intermediate, advanced
  gymType            String?   // own_gym, public_gym
  injuriesNotes      String?   @db.Text
  equipmentText      String?   @db.Text
  dailyCalorieTarget Int?
  dailyProteinTarget Float?
  carbsPercent       Int?      // % of remaining cals after protein for carbs
  fatPercent         Int?      // % of remaining cals after protein for fat
  sex                String?   // male, female, other, prefer_not_to_say
  trainingFrequency  Int?      // days per week, 1–7
  timezone           String    @default("UTC") // IANA timezone e.g. "America/New_York"
  weightUnit         String    @default("lb")  // "lb" or "kg" — user's preferred unit for logging
  isOnboarded        Boolean   @default(false)
  isAdmin            Boolean   @default(false)
  tier               String    @default("free") // free, pro, unlimited

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // FitClaude relations
  workouts             Workout[]
  nutritionLogs        NutritionLog[]
  nutritionSummaries   DailyNutritionSummary[]
  conversations        ConversationHistory[]
  apiTokens            ApiToken[]
  userFoods            UserFood[]
  magicLinkTokens      MagicLinkToken[]
  activities           Activity[]
  tokenUsages          TokenUsage[]
  usageLimit           UserUsageLimit?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Exercise Library
// ============================================

model Exercise {
  id               String   @id @default(cuid())
  name             String   @unique
  muscleGroup      String
  secondaryMuscles String?
  equipmentRequired String?
  difficulty       String   @default("intermediate")
  exerciseType     String   // compound, isolation, cardio, stretch, plyometric
  instructions     String?  @db.Text
  gifUrl           String?
  createdAt        DateTime @default(now())

  variations       ExerciseVariation[]
  workoutExercises WorkoutExercise[]
  videos           ExerciseVideo[]

  @@index([muscleGroup])
  @@map("exercises")
}

model ExerciseVariation {
  id                  String  @id @default(cuid())
  baseExerciseId      String
  name                String
  spicyLevel          Int     // 1-3
  modificationType    String  // tempo, grip, stance, load_curve, intensity, angle, unilateral, pause
  description         String  @db.Text
  additionalEquipment String?

  baseExercise     Exercise          @relation(fields: [baseExerciseId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@index([baseExerciseId])
  @@map("exercise_variations")
}

// ============================================
// Workouts
// ============================================

model Workout {
  id              String   @id @default(cuid())
  userId          String
  displayId       Int?     // user-facing routine number (e.g. #45)
  date            DateTime @default(now())
  name            String?
  workoutType     String   // push, pull, legs, upper, lower, full_body, cardio, custom
  category        String   @default("lifting") // lifting, hiit, cardio, mobility, calisthenics, sport
  source          String   @default("coach")   // "coach" = AI-generated, "manual" = user-logged external
  durationMinutes Int?
  notes           String?  @db.Text
  fatigueRating   Int?     // 1-10
  completed       Boolean  @default(false)
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId])
  @@index([userId, date])
  @@map("workouts")
}

model WorkoutExercise {
  id          String  @id @default(cuid())
  workoutId   String
  exerciseId  String?
  variationId String?
  order       Int
  sets        Int
  reps        String? // e.g. "8-12" or "10"
  weightKg    Float?
  restSeconds Int?
  notes       String?
  setLogs     String?  @db.Text // JSON: [{"set":1,"weight":195,"reps":4},...]
  wasSpicy       Boolean @default(false)
  supersetGroup  String? // "A", "B", etc. — exercises with same group form a superset pair

  workout   Workout            @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise  Exercise?          @relation(fields: [exerciseId], references: [id])
  variation ExerciseVariation? @relation(fields: [variationId], references: [id])

  @@index([workoutId])
  @@map("workout_exercises")
}

// ============================================
// Nutrition
// ============================================

model NutritionLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  mealType    String?  // breakfast, lunch, dinner, snack
  rawInput    String   @db.Text
  parsedItems String?  @db.Text // JSON string of parsed food items
  calories    Float?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  fiberG      Float?
  imageUrl    String?  // meal photo reference
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("nutrition_logs")
}

model DailyNutritionSummary {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  calories   Float    @default(0)
  proteinG   Float    @default(0)
  carbsG     Float    @default(0)
  fatG       Float    @default(0)
  fiberG     Float    @default(0)
  mealCount  Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_nutrition_summaries")
}

// ============================================
// Chat / Conversation History
// ============================================

model ConversationHistory {
  id        String   @id @default(cuid())
  userId    String
  role      String   // user, assistant
  content   String   @db.Text
  topic     String   @default("workout") // workout, nutrition
  toolUse   String?  @db.Text // JSON string of tool calls
  imageUrl  String?  // if message included an image
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, topic])
  @@map("conversation_history")
}

// ============================================
// YouTube Subagent — Pending Review
// ============================================

model PendingExercise {
  id                String    @id @default(cuid())
  name              String
  muscleGroup       String
  secondaryMuscles  String?
  equipmentRequired String?
  difficulty        String    @default("intermediate")
  exerciseType      String    // compound, isolation, cardio, stretch, plyometric
  instructions      String?   @db.Text
  youtubeVideoId    String?
  youtubeUrl        String?
  channelName       String?
  thumbnailUrl      String?
  status            String    @default("pending") // pending, approved, rejected
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  pendingVariations PendingVariation[]

  @@index([status])
  @@map("pending_exercises")
}

model PendingVariation {
  id                  String  @id @default(cuid())
  pendingExerciseId   String
  name                String
  spicyLevel          Int     @default(1)
  modificationType    String
  description         String  @db.Text
  additionalEquipment String?

  pendingExercise PendingExercise @relation(fields: [pendingExerciseId], references: [id], onDelete: Cascade)

  @@index([pendingExerciseId])
  @@map("pending_variations")
}

model ExerciseVideo {
  id             String    @id @default(cuid())
  exerciseId     String?
  exerciseName   String
  youtubeVideoId String
  youtubeUrl     String
  title          String
  channelName    String?
  thumbnailUrl   String?
  duration       String?   // ISO 8601 e.g. "PT5M30S"
  viewCount      Int?
  status         String    @default("pending") // pending, approved, rejected
  videoType      String    @default("tutorial") // tutorial (form-specific), reference (general/compilation)
  isPrimary      Boolean   @default(false)
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([exerciseId, youtubeVideoId])
  @@index([status])
  @@index([exerciseId])
  @@map("exercise_videos")
}

// ============================================
// Personal Food Database
// ============================================

model UserFood {
  id            String   @id @default(cuid())
  userId        String
  name          String
  servingAmount Float
  servingUnit   String
  calories      Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float?
  timesUsed     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_foods")
}

// ============================================
// Mobile API Tokens
// ============================================

model ApiToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  name      String   @default("ios")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("api_tokens")
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("magic_link_tokens")
}

// ============================================
// Activities (external classes / generic logs)
// ============================================

model Activity {
  id              String   @id @default(cuid())
  userId          String
  name            String
  durationMinutes Int?
  date            DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("activities")
}

// ============================================
// Token Usage Tracking (Admin)
// ============================================

model TokenUsage {
  id                  String   @id @default(cuid())
  userId              String
  endpoint            String   // "chat", "analytics", "chat_retry"
  model               String   // e.g. "claude-sonnet-4-20250514"
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  estimatedCostUsd    Float    @default(0)
  requestId           String?  // groups multiple API calls from one chat message
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("token_usage")
}

model UserUsageLimit {
  id               String   @id @default(cuid())
  userId           String   @unique
  maxCallsPerDay   Int?
  maxCallsPerWeek  Int?
  maxCallsPerMonth Int?
  maxCostPerMonth  Float?   // USD
  isThrottled      Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_usage_limits")
}
