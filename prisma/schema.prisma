generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Fitness profile fields
  age                Int?
  weightKg           Float?
  heightCm           Float?
  fitnessGoal        String?   // build_muscle, lose_fat, maintain, endurance, flexibility
  experienceLevel    String?   // beginner, intermediate, advanced
  gymType            String?   // own_gym, public_gym
  injuriesNotes      String?   @db.Text
  equipmentText      String?   @db.Text
  dailyCalorieTarget Int?
  dailyProteinTarget Float?
  sex                String?   // male, female, other, prefer_not_to_say
  trainingFrequency  Int?      // days per week, 1–7
  isOnboarded        Boolean   @default(false)

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // FitClaude relations
  workouts      Workout[]
  nutritionLogs NutritionLog[]
  conversations ConversationHistory[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Exercise Library
// ============================================

model Exercise {
  id               String   @id @default(cuid())
  name             String   @unique
  muscleGroup      String
  secondaryMuscles String?
  equipmentRequired String?
  difficulty       String   @default("intermediate")
  exerciseType     String   // compound, isolation, cardio, stretch, plyometric
  instructions     String?  @db.Text
  createdAt        DateTime @default(now())

  variations       ExerciseVariation[]
  workoutExercises WorkoutExercise[]

  @@index([muscleGroup])
  @@map("exercises")
}

model ExerciseVariation {
  id                  String  @id @default(cuid())
  baseExerciseId      String
  name                String
  spicyLevel          Int     // 1-3
  modificationType    String  // tempo, grip, stance, load_curve, intensity, angle, unilateral, pause
  description         String  @db.Text
  additionalEquipment String?

  baseExercise     Exercise          @relation(fields: [baseExerciseId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@index([baseExerciseId])
  @@map("exercise_variations")
}

// ============================================
// Workouts
// ============================================

model Workout {
  id              String   @id @default(cuid())
  userId          String
  displayId       Int?     // user-facing routine number (e.g. #45)
  date            DateTime @default(now())
  name            String?
  workoutType     String   // push, pull, legs, upper, lower, full_body, cardio, custom
  durationMinutes Int?
  notes           String?  @db.Text
  fatigueRating   Int?     // 1-10
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId])
  @@index([userId, date])
  @@map("workouts")
}

model WorkoutExercise {
  id          String  @id @default(cuid())
  workoutId   String
  exerciseId  String?
  variationId String?
  order       Int
  sets        Int
  reps        String? // e.g. "8-12" or "10"
  weightKg    Float?
  restSeconds Int?
  notes       String?
  setLogs     String?  @db.Text // JSON: [{"set":1,"weight":195,"reps":4},...]
  wasSpicy    Boolean @default(false)

  workout   Workout            @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise  Exercise?          @relation(fields: [exerciseId], references: [id])
  variation ExerciseVariation? @relation(fields: [variationId], references: [id])

  @@index([workoutId])
  @@map("workout_exercises")
}

// ============================================
// Nutrition
// ============================================

model NutritionLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now())
  mealType    String?  // breakfast, lunch, dinner, snack
  rawInput    String   @db.Text
  parsedItems String?  @db.Text // JSON string of parsed food items
  calories    Float?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  fiberG      Float?
  imageUrl    String?  // meal photo reference
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("nutrition_logs")
}

// ============================================
// Chat / Conversation History
// ============================================

model ConversationHistory {
  id        String   @id @default(cuid())
  userId    String
  role      String   // user, assistant
  content   String   @db.Text
  toolUse   String?  @db.Text // JSON string of tool calls
  imageUrl  String?  // if message included an image
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("conversation_history")
}
